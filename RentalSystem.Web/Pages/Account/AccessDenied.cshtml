@page
@model RentalSystem.Web.Pages.Account.AccessDeniedModel
@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentalMgr</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .card-shell {
            width: 100%;
            max-width: 520px;
            margin: 1rem;
            border-radius: 1.5rem;
            border: 1px solid #fde68a;
            background: #fffbeb;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        }
    </style>
</head>
<body>
    <section class="card-shell p-5 text-center">
        <div class="display-5 fw-bold text-warning-emphasis mb-3">Access denied</div>
        <p class="text-secondary mb-4">Your account is signed in, but it does not have permission to access this Razor Page.</p>
        <div class="d-flex gap-2 justify-content-center">
            @if (isAuthenticated)
            {
                <a asp-page="/Index" class="btn btn-primary">Go to Dashboard</a>
                <form method="post" asp-page="/Account/Logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary">Switch Account</button>
                </form>
            }
            else
            {
                <a asp-page="/Account/Login" class="btn btn-primary">Sign In</a>
            }
        </div>
    </section>
</body>
</html>
