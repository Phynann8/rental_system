@page
@model RentalSystem.Web.Pages.Account.LoginModel
@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentalMgr</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: radial-gradient(circle at top, rgba(19, 127, 236, 0.18), transparent 35%), linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            width: 100%;
            max-width: 460px;
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 1.5rem;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.15);
            overflow: hidden;
        }

        .auth-card-body {
            padding: 2rem;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            background: rgba(19, 127, 236, 0.1);
            color: #137fec;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        .auth-title {
            margin-top: 1rem;
            margin-bottom: 0.5rem;
            font-size: 2rem;
            font-weight: 800;
            color: #0f172a;
        }

        .auth-subtitle {
            margin-bottom: 1.5rem;
            color: #64748b;
        }

        .btn-primary {
            background: #137fec;
            border-color: #137fec;
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }
    </style>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-card-body">
                <div class="brand-badge">
                    <span class="material-symbols-outlined">lock</span>
                    Secure Access
                </div>
                <h1 class="auth-title">Sign in to RentalMgr</h1>
                <p class="auth-subtitle">Razor Pages are protected in production. Sign in with an assigned account to continue.</p>

                <form method="post">
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold">Username or email</label>
                        <input asp-for="Input.Username" class="form-control form-control-lg" autocomplete="username" />
                        <span asp-validation-for="Input.Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Input.Password" class="form-control form-control-lg" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Remember this device</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
                </form>

                @if (HostEnvironment.IsDevelopment())
                {
                    <div class="alert alert-info mt-4 mb-0 small">
                        Development accounts:
                        <strong>admin</strong> / <strong>Admin123!</strong>,
                        <strong>manager</strong> / <strong>Rental123!</strong>,
                        <strong>billing</strong> / <strong>Billing123!</strong>
                    </div>
                }
            </div>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
