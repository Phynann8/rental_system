@page
@model RentalSystem.Web.Pages.Configuration.RoomTypes.CreateModel
@{
    ViewData["Title"] = "Create Room Type";
}

<div class="container mt-4">
    <h2>Create Room Type</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="RoomType.Name" class="form-label"></label>
                    <input asp-for="RoomType.Name" class="form-control" />
                    <span asp-validation-for="RoomType.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="RoomType.BasePrice" class="form-label"></label>
                    <input asp-for="RoomType.BasePrice" class="form-control" />
                    <span asp-validation-for="RoomType.BasePrice" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="RoomType.Description" class="form-label"></label>
                    <textarea asp-for="RoomType.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="RoomType.Description" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
