@page
@model RentalSystem.Web.Pages.Configuration.RoomTypes.IndexModel
@{
    ViewData["Title"] = "Room Types";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create New
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Base Price</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RoomTypes)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.BasePrice.ToString("C")</td>
                    <td>@item.Description</td>
                    <td>
                        @* <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> *@
                        @* <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
