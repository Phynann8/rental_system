@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <!-- Welcome Banner -->
        <div class="card border-0 shadow-sm text-white overflow-hidden" style="background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%); border-radius: 1rem;">
            <div class="card-body p-4 p-md-5 position-relative">
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80'); background-size: cover; opacity: 0.1; mix-blend-mode: overlay;"></div>
                <div class="row align-items-center position-relative">
                    <div class="col-md-8">
                        <h2 class="fw-bold mb-2">Welcome back!</h2>
                        <p class="mb-0 text-white-50">Here's what's happening with your properties today. You have <strong class="text-white">@Model.PendingInvoicesCount</strong> invoices pending review.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AI Insights -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border border-primary-subtle bg-primary-subtle rounded-4">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="d-flex align-items-center text-primary fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                    <span class="material-symbols-outlined me-1 icon-pulse">lightbulb</span>
                    AI Insights
                </div>
                <div class="vr bg-primary opacity-25"></div>
                <div class="text-muted small flex-grow-1">
                    Based on your data, occupancy is stable at <strong>@Model.OccupancyRate.ToString("0.0")%</strong>. Consider reviewing overdue invoices to improve cash flow.
                </div>
                <a href="#" class="text-primary fw-bold text-decoration-none small">Refresh</a>
            </div>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div class="row g-4 mb-4">
    <!-- Occupancy -->
    <div class="col-md-4">
        <div class="card card-stats h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <p class="text-muted small fw-medium mb-1">Occupancy Rate</p>
                        <h3 class="fw-bold mb-0">@Model.OccupancyRate.ToString("0.0")%</h3>
                    </div>
                    <div class="p-2 rounded bg-success-subtle text-success">
                        <span class="material-symbols-outlined">home</span>
                    </div>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.OccupancyRate%" aria-valuenow="@Model.OccupancyRate" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="mt-2 small text-muted">
                    <span class="text-success fw-bold">@Model.OccupiedRooms</span> / @Model.TotalRooms Rooms Occupied
                </div>
            </div>
        </div>
    </div>

    <!-- Revenue -->
    <div class="col-md-4">
        <div class="card card-stats h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <p class="text-muted small fw-medium mb-1">Projected Monthly Revenue</p>
                        <h3 class="fw-bold mb-0">@Model.MonthlyRevenue.ToString("C")</h3>
                    </div>
                    <div class="p-2 rounded bg-primary-subtle text-primary">
                        <span class="material-symbols-outlined">payments</span>
                    </div>
                </div>
                <div class="mt-2 small">
                    <span class="text-success fw-bold">Active Contracts</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Invoices -->
    <div class="col-md-4">
        <div class="card card-stats h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <p class="text-muted small fw-medium mb-1">Pending Invoices</p>
                        <h3 class="fw-bold mb-0">@Model.PendingInvoicesCount</h3>
                    </div>
                    <div class="p-2 rounded bg-warning-subtle text-warning-emphasis">
                        <span class="material-symbols-outlined">warning</span>
                    </div>
                </div>
                 <div class="mt-2 small text-muted">
                    Total Pending: <span class="text-danger fw-bold">@Model.PendingInvoicesAmount.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts & Activity -->
<div class="row mb-4">
    <!-- Chart -->
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card card-stats h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">Monthly Revenue</h5>
                    <small class="text-muted">Income over the last 6 months</small>
                </div>
            </div>
            <div class="card-body px-4 pb-4">
                <div style="height: 300px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-lg-4">
        <div class="card card-stats h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Activity</h5>
                <a href="#" class="small text-primary fw-bold text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (Model.RecentPayments.Any())
                    {
                        @foreach (var payment in Model.RecentPayments)
                        {
                            <div class="list-group-item border-0 px-4 py-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 rounded bg-success-subtle text-success">
                                        <span class="material-symbols-outlined fs-5">attach_money</span>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-0 fw-bold small">Payment Received</h6>
                                            <small class="text-muted" style="font-size: 0.7rem;">@payment.Date.ToString("MMM dd")</small>
                                        </div>
                                        <p class="mb-0 text-muted small">
                                            @payment.Invoice?.Contract?.Tenant?.Name paid @payment.Amount.ToString("C") for @payment.Invoice?.Contract?.Room?.RoomNumber.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                         <div class="p-4 text-center text-muted small">No recent activity</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Invoices Table -->
<div class="row">
    <div class="col-12">
        <div class="card card-stats shadow-sm">
             <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Invoices</h5>
                <a asp-page="/Billing/Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 text-muted small text-uppercase">Invoice #</th>
                                <th class="border-0 text-muted small text-uppercase">Date</th>
                                <th class="border-0 text-muted small text-uppercase">Tenant</th>
                                <th class="border-0 text-muted small text-uppercase">Room</th>
                                <th class="border-0 text-muted small text-uppercase">Amount</th>
                                <th class="border-0 text-muted small text-uppercase">Status</th>
                                <th class="border-0 text-muted small text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentInvoices.Any())
                            {
                                @foreach (var inv in Model.RecentInvoices)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">#@inv.Id</td>
                                        <td>@inv.Date.ToShortDateString()</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 10px;">
                                                    @inv.Contract.Tenant.Name.Substring(0, 1)
                                                </div>
                                                @inv.Contract.Tenant.Name
                                            </div>
                                        </td>
                                        <td>@inv.Contract.Room.RoomNumber</td>
                                        <td class="fw-bold">@inv.TotalAmount.ToString("C")</td>
                                        <td>
                                            @if(inv.Status == RentalSystem.Web.Models.InvoiceStatus.Paid)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Paid</span>
                                            }
                                            else if(inv.Status == RentalSystem.Web.Models.InvoiceStatus.Partial)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">Partial</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2">Unpaid</span>
                                            }
                                        </td>
                                        <td>
                                             @if(inv.Status != RentalSystem.Web.Models.InvoiceStatus.Paid)
                                            {
                                                <a asp-page="/Billing/ReceivePayment" asp-route-id="@inv.Id" class="btn btn-sm btn-success py-0 px-2" style="font-size: 0.8rem;">
                                                    Pay
                                                </a>
                                            }
                                            <a asp-page="/Print/Invoice" asp-route-id="@inv.Id" target="_blank" class="btn btn-sm btn-light text-muted py-0 px-2">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">print</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No recent invoices found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            
            // Data from Model
            const labels = @Json.Serialize(Model.MonthlyRevenueLabels);
            const data = @Json.Serialize(Model.MonthlyRevenueData);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Revenue',
                        data: data,
                        backgroundColor: '#0ea5e9',
                        borderRadius: 4,
                        barThickness: 30
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                borderDash: [2, 4],
                                color: '#e5e7eb',
                                drawBorder: false
                            },
                            ticks: { display: true }
                        },
                        x: {
                            grid: { display: false },
                            border: { display: false }
                        }
                    }
                }
            });
        });
    </script>
}
