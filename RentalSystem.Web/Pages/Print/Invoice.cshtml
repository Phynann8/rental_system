@page "{id:int}"
@model RentalSystem.Web.Pages.Print.InvoiceModel
@{
    Layout = null; // No standard layout, specialized print layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Print Invoice #@Model.Invoice.Id</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #eee; /* Light gray background to see paper size on screen */
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .a4-page {
            width: 210mm;
            height: 297mm;
            background: white;
            margin: 10mm auto;
            position: relative;
            box-shadow: 0 0.5cm rgba(0,0,0,0.5);
            /* Grid layout for 2x A5 */
            display: flex;
            flex-direction: column;
        }

        .a5-container {
            height: 50%; /* Each takes half the page height */
            padding: 15mm;
            box-sizing: border-box;
            position: relative;
        }

        .cut-line {
            border-top: 1px dashed #999;
            width: 90%;
            margin: 0 auto;
            position: absolute;
            top: 50%;
            left: 5%;
        }
        
        /* Receipt Styling */
        .receipt-header {
            display: flex;
            justify-content: space-between;
            border-bottom: 2px solid #333;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
        }

        .company-name { font-size: 1.5rem; font-weight: bold; color: #d63384; /* Example color */ }
        .invoice-title { font-size: 1.2rem; font-weight: bold; text-align: right; }

        .invoice-details { margin-bottom: 1rem; }
        .invoice-details span { display: block; }

        .total-box {
            background-color: #f8f9fa;
            border: 2px solid #333;
            padding: 0.5rem;
            text-align: right;
            font-weight: bold;
            font-size: 1.2rem;
            margin-top: 1rem;
        }

        @@media print {
            body { background: white; margin: 0; }
            .a4-page {
                box-shadow: none;
                margin: 0;
                width: 100%;
                height: 100%;
            }
            .no-print { display: none; }
        }
    </style>
</head>
<body>

    <div class="a4-page">
        <!-- TOP COPY (Customer) -->
        <div class="a5-container">
            <div class="text-end text-muted small mb-2">CUSTOMER COPY</div>
            <partial name="_InvoiceTemplate" model="Model.Invoice" />
        </div>

        <!-- Cutting Line -->
        <div class="cut-line"></div>

        <!-- BOTTOM COPY (File) -->
        <div class="a5-container">
            <div class="text-end text-muted small mb-2">FILE COPY</div>
            <partial name="_InvoiceTemplate" model="Model.Invoice" />
        </div>
    </div>

</body>
</html>
