@page "{id:int}"
@model RentalSystem.Web.Pages.Print.ReceiptModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Receipt #@Model.Payment.Id</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        @@media print {
            @@page {
                size: A4;
                margin: 0;
            }
            .no-print { display: none; }
        }
        body { margin: 0; padding: 0.5cm; font-family: sans-serif; }
        .a4-container {
            width: 210mm;
            height: 297mm;
            margin: auto;
            display: flex;
            flex-direction: column;
        }
        .a5-half {
            height: 50%;
            border: 1px dashed #ccc;
            padding: 1.5cm;
            position: relative;
        }
        .cut-line {
            border-top: 1px dashed #888;
            margin: 0;
            position: relative;
        }
        .cut-line::after {
            content: '✂';
            position: absolute;
            left: 50%;
            top: -12px;
            background: #fff;
            padding: 0 5px;
        }
        .receipt-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px; }
        .company-name { font-size: 1.5rem; font-weight: bold; }
        .invoice-title { font-size: 1.8rem; font-weight: bold; text-align: right; }
    </style>
</head>
<body onload="window.print()">
    <div class="a4-container">
        <!-- TOP COPY (Owner) -->
        <div class="a5-half">
            <div class="badge bg-secondary position-absolute top-0 end-0 m-2 no-print">OWNER COPY</div>
            <partial name="_ReceiptTemplate" model="Model.Payment" />
        </div>

        <div class="cut-line"></div>

        <!-- BOTTOM COPY (Tenant) -->
        <div class="a5-half">
            <div class="badge bg-secondary position-absolute top-0 end-0 m-2 no-print">TENANT COPY</div>
            <partial name="_ReceiptTemplate" model="Model.Payment" />
        </div>
    </div>
</body>
</html>
