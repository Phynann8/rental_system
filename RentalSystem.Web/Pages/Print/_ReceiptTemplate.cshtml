@model RentalSystem.Web.Models.Payment

<div class="receipt-header">
    <div class="company-name">
        MY RENTAL SYSTEM <br />
        <small style="font-size: 0.8rem; font-weight: normal; color: #555;">123 Street, Phnom Penh</small>
    </div>
    <div class="invoice-title text-success">
        OFFICIAL RECEIPT<br />
        <small>#RCT-@Model.Id.ToString("D5")</small>
    </div>
</div>

<div class="row mb-3">
    <div class="col-6">
        <strong>Received From:</strong><br />
        @Model.Invoice?.Contract?.Tenant?.Name<br />
        Room: @Model.Invoice?.Contract?.Room?.RoomNumber
    </div>
    <div class="col-6 text-end">
        <strong>Receipt Date:</strong> @Model.Date.ToShortDateString()<br />
        <strong>Invoice Ref:</strong> #@Model.InvoiceId.ToString("D5")
    </div>
</div>

<div class="border p-3 mb-3 bg-light">
    <div class="row align-items-center">
        <div class="col-8">
            <h4 class="mb-0">Amount Received:</h4>
            <p class="text-muted small mb-0">Payment Method: @Model.Method</p>
        </div>
        <div class="col-4 text-end">
            <h3 class="fw-bold mb-0">@Model.Amount.ToString("C")</h3>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <p class="text-muted small">
            Thank you for your payment. This is a computer-generated receipt and requires no signature.
        </p>
    </div>
</div>

<div class="row">
    <div class="col-6 pt-3">
        <div style="border-bottom: 1px solid #000; width: 150px; margin-top: 30px;"></div>
        <small>Receiver Signature</small>
    </div>
</div>
