@using System.Security.Claims
@using RentalSystem.Web.Security
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var displayName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "User";
    var primaryRole = User.FindFirstValue(ClaimTypes.Role) ?? "Member";
    var avatarName = System.Uri.EscapeDataString(displayName);
    var canManageProperties = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
    var canHandleBilling = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Billing);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentalMgr</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentalSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <div class="logo-icon">
                        <span class="material-symbols-outlined">apartment</span>
                    </div>
                    <span>RentalMgr</span>
                </div>
            </div>

            <div class="sidebar-nav">
                <a asp-page="/Index" class="nav-item @(currentPage == "/Index" ? "active" : "")">
                    <span class="material-symbols-outlined">dashboard</span>
                    Dashboard
                </a>

                @if (canManageProperties)
                {
                    <a asp-page="/Configuration/Buildings/Index" class="nav-item @(currentPage.Contains("/Buildings") ? "active" : "")">
                        <span class="material-symbols-outlined">domain</span>
                        Properties
                    </a>
                    <a asp-page="/Configuration/Rooms/Index" class="nav-item @(currentPage.Contains("/Rooms") ? "active" : "")">
                        <span class="material-symbols-outlined">grid_view</span>
                        Rooms
                    </a>
                    <a asp-page="/Tenancy/Tenants/Index" class="nav-item @(currentPage.Contains("/Tenants") ? "active" : "")">
                        <span class="material-symbols-outlined">group</span>
                        Tenants
                    </a>
                }

                @if (canHandleBilling)
                {
                    <a asp-page="/Billing/Index" class="nav-item @(currentPage.Contains("/Billing") ? "active" : "")">
                        <span class="material-symbols-outlined">receipt_long</span>
                        Invoices
                    </a>
                }

                <a asp-page="/Reports/Index" class="nav-item @(currentPage.Contains("/Reports") ? "active" : "")">
                    <span class="material-symbols-outlined">bar_chart</span>
                    Reports
                </a>

                @if (canManageProperties)
                {
                    <div class="my-2 border-top mx-3"></div>

                    <a asp-page="/Configuration/RoomTypes/Index" class="nav-item @(currentPage.Contains("/Configuration/RoomTypes") ? "active" : "")">
                        <span class="material-symbols-outlined">settings</span>
                        Settings
                    </a>
                }
            </div>

            <div class="sidebar-footer">
                <div class="user-profile">
                    <img src="https://ui-avatars.com/api/?name=@avatarName&background=0D8ABC&color=fff" alt="@displayName" class="user-avatar">
                    <div class="d-flex flex-column" style="overflow: hidden;">
                        <span class="text-truncate fw-bold" style="font-size: 0.875rem;">@displayName</span>
                        <span class="text-truncate text-muted" style="font-size: 0.75rem;">@primaryRole access</span>
                    </div>
                </div>
                <form method="post" asp-page="/Account/Logout" class="mt-3">
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Sign out</button>
                </form>
            </div>
        </nav>

        <main class="main-area">
            <header class="top-header">
                <div>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
                <div class="header-actions">
                    <div class="d-none d-sm-block position-relative">
                        <span class="material-symbols-outlined position-absolute text-muted" style="left: 10px; top: 8px; font-size: 20px;">search</span>
                        <input type="text" class="form-control border-0 bg-light" placeholder="Search..." style="padding-left: 35px; width: 250px;">
                    </div>
                    <button class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined text-muted" style="font-size: 20px;">notifications</span>
                    </button>
                </div>
            </header>

            <div class="content-scrollable">
                <div class="container-fluid p-0">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
