@page
@model RentalSystem.Web.Pages.Tenancy.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenants";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-end align-items-center mb-3">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Tenant
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>National ID</th>
                <th>Hometown</th>
                <th>Active Contracts</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Tenants)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Phone</td>
                    <td>@item.NationalId</td>
                    <td>@item.Hometown</td>
                    <td>
                        <span class="badge bg-info text-dark">@item.Contracts.Count(c => c.Status == RentalSystem.Web.Models.ContractStatus.Active)</span>
                    </td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
