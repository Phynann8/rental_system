{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/rentalmgr-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Auth": {
    "Password": {
      "RequiredLength": 10,
      "RequiredUniqueChars": 4,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    },
    "Session": {
      "IdleTimeoutMinutes": 480,
      "ValidationIntervalMinutes": 5
    },
    "BootstrapAdmin": {
      "Username": "",
      "Email": "",
      "Password": "",
      "DisplayName": ""
    }
  },
  "Messaging": {
    "Smtp": {
      "Host": "smtp.mailtrap.io",
      "Port": 587,
      "Username": "YOUR_USERNAME",
      "Password": "YOUR_PASSWORD",
      "FromEmail": "notifications@rentalmgr.example.com",
      "FromName": "RentalMgr Notifications",
      "UseSsl": false,
      "EnableEmail": false
    }
  },
  "AllowedHosts": "*"
}
